APP_NAME="Yandex Reviews"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (MySQL by default; sqlite works for a quick local run) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yandex_reviews
DB_USERNAME=laravel
DB_PASSWORD=secret

# ---- Queue / cache / session ----
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- SPA / Sanctum ----
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Single seed user (no registration) ----
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=password

# ---- Yandex parser ----
# fixture  = replay the bundled snapshot (no browser needed) — great for a
#            quick local run and for CI.
# headless = drive the Node/Playwright scraper service (real scraping).
YANDEX_PARSER_DRIVER=fixture
YANDEX_SCRAPER_URL=http://scraper:3000
YANDEX_SCRAPER_TIMEOUT=600
YANDEX_MAX_REVIEWS=600
